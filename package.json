{
  "name": "norn",
  "version": "0.1.0",
  "description": "Harness-agnostic runtime for agent-driven and code-driven workflows, built primarily for agents.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "coding-agent",
    "workflows",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimhead/norn.git"
  },
  "homepage": "https://github.com/vimhead/norn#readme",
  "bugs": {
    "url": "https://github.com/vimhead/norn/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    ".cursor-plugin",
    "docs",
    "setup",
    "adapters",
    "bin",
    "src",
    "examples",
    "tests/workflow-ref.test.ts"
  ],
  "pi": {
    "extensions": ["./adapters/pi.ts"]
  },
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./client": "./src/client.ts",
    "./documentation": "./src/documentation.ts",
    "./schema": "./src/schema.ts",
    "./seer": "./src/seer/index.ts",
    "./examples/worktree-development-loop": "./examples/worktree-development-loop/plugin.ts"
  },
  "bin": {
    "norn": "./bin/norn.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "jiti": "^2.7.0",
    "typebox": "^1.3.17",
    "zod": "^4.4.3"
  },
  "bundledDependencies": [
    "@earendil-works/pi-coding-agent"
  ],
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "^26.2.0",
    "bun": "1.4.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "documentation:generate": "node scripts/generate-documentation-assets.ts",
    "pi:assets": "node scripts/generate-pi-assets.ts",
    "check": "npm run pi:assets && npm run documentation:generate && tsc --noEmit",
    "test": "vitest run",
    "build:cli": "npm run check",
    "release:dry": "npm run build:cli && npm pack --dry-run",
    "release:pack": "npm run build:cli && npm pack",
    "pack:dry": "npm run release:dry",
    "build:binary": "npm run check && bun build --compile ./src/bun/cli.ts --outfile dist/norn",
    "release:binary": "npm run build:binary"
  }
}
