{
	"name": "@vimhead.dev/norn-cli",
	"version": "0.1.0-tip.0",
	"description": "Harness-agnostic runtime for agent-driven and code-driven workflows, built primarily for agents.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vimhead/norn.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/vimhead/norn#readme",
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "tip"
	},
	"files": [
		"bin",
		"dist",
		"assets",
		"README.md"
	],
	"bin": {
		"norn": "./bin/norn.mjs"
	},
	"exports": {
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./documentation": {
			"types": "./dist/documentation.d.ts",
			"import": "./dist/documentation.js"
		}
	},
	"scripts": {
		"build": "node ../../scripts/build-package.ts"
	},
	"devDependencies": {
		"@vimhead.dev/norn-core": "workspace:*"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.0.3",
		"@vimhead.dev/norn": "workspace:*",
		"jiti": "^2.7.0",
		"typebox": "^1.3.34"
	}
}
