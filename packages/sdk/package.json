    "./schema": { "types": "./dist/schema.d.ts", "import": "./dist/schema.js" },
    "./seer": { "types": "./dist/seer/index.d.ts", "import": "./dist/seer/index.js" }
  },
  "scripts": { "build": "node ../../scripts/build-package.ts" },
  "devDependencies": { "@vimhead.dev/norn-core": "workspace:*" },
