{
  "name": "@vimhead.dev/norn",
  "version": "0.1.0-tip.0",
  "description": "TypeScript SDK for building agent-driven and code-driven Norn workflows.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/vimhead/norn.git", "directory": "packages/sdk" },
  "homepage": "https://github.com/vimhead/norn#readme",
  "engines": { "node": ">=22.19.0" },
  "publishConfig": { "access": "public", "tag": "tip" },
